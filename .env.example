# Copy to .env and fill in. Never commit the real .env.

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Created by "flask init-db --seed"; the first login forces a password change.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026

# Where the SQLite file lives (WAL mode).
DATABASE=instance/ella.db

# sandbox | bakong      (bakong needs KHQR merchant credentials)
PAYMENT_PROVIDER=sandbox
# sandbox | supplier    (supplier needs a real top-up API key)
SUPPLIER_ADAPTER=sandbox

# Minutes a KHQR code stays valid, per proposal section 4.1
ORDER_TTL_MINUTES=10

# Set to 1 in production behind HTTPS
SESSION_COOKIE_SECURE=0
